{
  "name": "rhine-lab-analysis-os",
  "version": "1.0.2",
  "description": "《明日方舟》特别映像「莱茵生命：访问」终端界面的非官方复刻，含桌面 SSH 工作区。",
  "author": "LBEILC",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && node scripts/prepare-webfonts.mjs",
    "check:content": "node --experimental-strip-types --test scripts/check-content.mjs",
    "check:ssh": "node --experimental-strip-types scripts/check-ssh-events.mjs",
    "check:ssh-session": "node --experimental-strip-types scripts/check-ssh-session.mjs",
    "check:ssh-pty-lifecycle": "node scripts/check-ssh-pty-lifecycle.mjs",
    "check:ssh-real-client": "node --experimental-strip-types scripts/check-ssh-real-client.mjs",
    "check:ssh-handshake": "node --experimental-strip-types scripts/check-ssh-handshake.mjs",
    "check:ssh-traffic": "node --experimental-strip-types scripts/check-ssh-traffic.mjs",
    "check:ssh-audit": "node --experimental-strip-types scripts/check-ssh-audit.mjs",
    "check:ssh-client": "node --experimental-strip-types scripts/check-ssh-client.mjs",
    "check:ssh-host": "node scripts/check-ssh-host.mjs",
    "check:ssh-profiles": "node scripts/check-ssh-profiles.mjs",
    "check:ssh-column": "node --experimental-strip-types scripts/check-ssh-host-column.mjs",
    "check:ssh-clipboard": "node --test scripts/check-terminal-clipboard.mjs",
    "check:ssh-diagnostic": "node --test scripts/check-diagnostic-log.cjs && node node_modules/electron/cli.js scripts/check-diagnostic-native.cjs",
    "check:ssh-terminal-tools": "node scripts/check-terminal-deck.mjs --tools --out verification/ssh-terminal-tools/browser",
    "check:ssh-deck-teardown": "node scripts/check-deck-teardown.mjs",
    "check:ssh-overview-collapse": "node scripts/check-overview-collapse.mjs",
    "check:ssh-terminal-deck": "node scripts/check-terminal-deck.mjs --out verification/terminal-deck",
    "check:ssh-session-agent": "node --experimental-strip-types scripts/check-ssh-session-agent.mjs",
    "check:android-ssh-driver": "node --experimental-strip-types scripts/check-android-ssh-driver.mjs",
    "check:ssh-services-unit": "node --test scripts/check-ssh-services-unit.mjs",
    "check:ssh-credentials": "node --test scripts/check-ssh-credentials.mjs",
    "check:ssh-credentials-native": "node scripts/check-ssh-services.mjs --credentials-only --out .tools/ssh-overview-credentials-native",
    "check:ssh-overview": "node scripts/check-terminal-deck.mjs --multi --out .tools/ssh-overview-review",
    "check:ssh-overview-performance": "node scripts/check-terminal-deck.mjs --multi --performance --out .tools/ssh-overview-performance",
    "check:ssh-services": "node scripts/check-ssh-services.mjs",
    "check:ssh-multisession-unit": "node --experimental-strip-types --test scripts/check-ssh-workspace-unit.mjs",
    "check:ssh-multisession": "node scripts/check-terminal-deck.mjs --multi --out verification/ssh-workspace-upgrade/multi",
    "check:ssh-multisession-native": "node scripts/check-ssh-services.mjs --multi-only --out verification/ssh-workspace-upgrade/native",
    "check:ssh-workspace": "node scripts/check-terminal-deck.mjs --workspace --out verification/ssh-workspace/browser",
    "check:ssh-editor-close": "node scripts/check-ssh-editor-close.mjs && node scripts/check-ssh-editor-close.mjs --hang-save",
    "check:ssh-terminal-geometry": "node scripts/check-terminal-deck.mjs --workspace --geometry --out verification/ssh-workspace/geometry",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "check:android": "node scripts/check-android.mjs",
    "build:android-assets": "node --experimental-strip-types scripts/build-android-assets.mjs",
    "android:add": "cap add android",
    "build:android": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode android --outDir dist-android",
    "android:sync": "npm run build:android && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android-native.mjs && node scripts/android-build.mjs",
    "build:android-native": "node scripts/build-android-native.mjs",
    "android:apk": "node scripts/android-build.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "build:wallpaper": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode wallpaper --outDir release/wallpaper && node scripts/build-wallpaper.mjs",
    "build:ssh-services": "node scripts/build-ssh-services.mjs",
    "build:app-icon": "node --experimental-strip-types scripts/build-app-icon.mjs",
    "dist": "npm run build:desktop && electron-builder --win --publish never",
    "dist:dir": "npm run build:desktop && electron-builder --win --dir --publish never",
    "predev:desktop": "node electron/ensure.cjs && node scripts/build-ssh-services.mjs --ensure",
    "dev:desktop": "node electron/dev.cjs",
    "prebuild:desktop": "node electron/ensure.cjs && node scripts/build-ssh-services.mjs --ensure",
    "build:desktop": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && tsc && vite build --mode desktop --outDir dist-desktop",
    "prestart:desktop": "node electron/ensure.cjs && node scripts/build-ssh-services.mjs --ensure",
    "start:desktop": "electron .",
    "smoke:desktop": "electron . --smoke",
    "smoke:desktop:session": "electron . --session-smoke",
    "smoke:desktop:terminal": "electron . --session-smoke --terminal-deck-only",
    "smoke:desktop:hosts": "electron . --session-smoke --host-management-only",
    "smoke:desktop:multisession": "electron . --session-smoke --multisession-only",
    "smoke:desktop:editor": "electron . --session-smoke --editor-only",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "check:ssh-inspection": "node scripts/check-terminal-deck.mjs --inspection --out verification/redesign",
    "check:ssh-inspection-sessions": "node scripts/check-terminal-deck.mjs --sessions --out verification/redesign-sessions",
    "check:ssh-inspection-performance": "node scripts/check-inspection-performance.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/status-bar": "^6.0.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@kitlangton/rolling-number": "0.4.1",
    "@lezer/highlight": "1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "6.0.2",
    "node-pty": "^1.1.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@types/three": "^0.183.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
