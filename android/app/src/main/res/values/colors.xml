<?xml version="1.0" encoding="utf-8"?>
<!--
  The palette the launch theme paints before any JavaScript runs: the window
  background is the app's paper, and the accent is the amber the interface uses
  for its one warm signal. `styles.xml` referenced all three names but the
  template shipped no colour resources, so they are defined here.
-->
<resources>
    <color name="colorPrimary">#e8e5e1</color>
    <color name="colorPrimaryDark">#e8e5e1</color>
    <color name="colorAccent">#9b7247</color>
</resources>
